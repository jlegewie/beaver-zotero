{
  "compilerOptions": {
    "experimentalDecorators": true,
    "module": "commonjs",
    "target": "ES2016",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    // Prefer path prefixes over baseUrl
    "paths": {
      "zotero-plugin-toolkit/*": ["./node_modules/zotero-plugin-toolkit/*"],
      "../../addon/content/reactBundle": ["./typings/reactBundle.d.ts"],
      // `packages` is deliberately absent from `include`: agent-core's
      // globals.d.ts declares narrowed `navigator`/`crypto`/`URL` that would
      // clash with lib.dom here. Both packages' sources still enter this
      // program by being imported, and each has its own standalone gate
      // (`npm run typecheck:core` / `npm run typecheck:ui`).
      "@beaver/agent-core/*": ["./packages/agent-core/src/*"],
      "@beaver/agent-ui/*": ["./packages/agent-ui/src/*"]
    },
    "jsx": "react",
    "esModuleInterop": true,
    "lib": ["DOM", "ES2016"],
    "noEmit": true
  },
  "include": ["src", "react", "typings", "node_modules/zotero-types"],
  "exclude": [
    "build",
    "addon",
    "src/beaver-extract/node",
    "src/beaver-extract/cli"
  ]
}
