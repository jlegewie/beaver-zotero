{
    "name": "beaver-zotero",
    "type": "module",
    "version": "0.26.2",
    "description": "Academic research agent that lives in Zotero, instantly searching through all your documents and explaining complex concepts as you read.",
    "config": {
        "addonName": "Beaver",
        "addonID": "beaver@jlegewie.com",
        "addonRef": "beaver",
        "addonInstance": "Beaver",
        "prefsPrefix": "extensions.zotero.beaver"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jlegewie/beaver-zotero.git"
    },
    "author": "JL",
    "bugs": {
        "url": "https://github.com/jlegewie/beaver-zotero/issues"
    },
    "homepage": "https://www.beaverapp.ai",
    "license": "AGPL-3.0-or-later",
    "scripts": {
        "start": "npm run copy:agent-ui-css && concurrently \"zotero-plugin serve\" \"npm run watch-react\"",
        "build": "npm run copy:agent-ui-css && NODE_ENV=production npm run build-react:prod && NODE_ENV=production zotero-plugin build && tsc --noEmit && npm run typecheck:core && npm run typecheck:ui && npm run typecheck:export && npm run check:bundle",
        "build:dev": "npm run copy:agent-ui-css && NODE_ENV=development npm run build-react:dev && NODE_ENV=development zotero-plugin build --dev && NODE_ENV=development npm run pack:xpi && tsc --noEmit && npm run typecheck:core && npm run typecheck:ui && npm run typecheck:export && npm run check:bundle",
        "build:staging": "npm run copy:agent-ui-css && BUILD_ENV=staging npm run build-react:staging && BUILD_ENV=staging zotero-plugin build && tsc --noEmit && npm run typecheck:core && npm run typecheck:ui && npm run typecheck:export && npm run check:bundle",
        "check:bundle": "node scripts/check-esbuild-graph.mjs",
        "lint:check": "prettier --check . && eslint .",
        "lint:fix": "prettier --write . && eslint . --fix",
        "release": "zotero-plugin release",
        "test": "vitest run",
        "test:live": "vitest run --config vitest.live.config.ts",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:all": "npm test && npm run test:live && npm run test:integration",
        "bench:pdf": "BEAVER_BENCH=1 vitest run --config vitest.live.config.ts tests/live/markdownEnginesBench.live.test.ts",
        "test:watch": "vitest",
        "update-deps": "npm update --save",
        "build-react": "webpack --config webpack.config.js --mode=development",
        "build-react:dev": "webpack --config webpack.config.js --mode=development",
        "build-react:prod": "webpack --config webpack.config.js --mode=production",
        "build-react:staging": "BUILD_ENV=staging webpack --config webpack.config.js --mode=production",
        "watch-react": "webpack --config webpack.config.js --mode=development --watch",
        "voice:build": "native/voice/macos/build.sh",
        "voice:package:dev": "node native/voice/macos/package.mjs --development",
        "pack:xpi": "node scripts/pack-xpi.mjs",
        "copy:agent-ui-css": "node scripts/copy-agent-ui-css.mjs",
        "beaver-extract": "tsx src/beaver-extract/cli/main.ts",
        "typecheck:cli": "tsc -p tsconfig.cli.json --noEmit",
        "typecheck:core": "tsc -p packages/agent-core --noEmit && node packages/agent-core/verify-program.mjs",
        "typecheck:ui": "tsc -p packages/agent-ui --noEmit && node packages/agent-ui/verify-program.mjs",
        "typecheck:export": "tsc -p packages/agent-export --noEmit && node packages/agent-export/verify-program.mjs",
        "test:cli-smoke": "vitest run --config vitest.smoke.config.ts"
    },
    "dependencies": {
        "@babel/preset-typescript": "^7.26.0",
        "@lexical/react": "^0.53.0",
        "@lexical/utils": "^0.53.0",
        "@supabase/supabase-js": "^2.118.0",
        "date-fns": "^4.4.0",
        "date-fns-tz": "^3.2.0",
        "deepmerge": "^4.3.1",
        "diff": "^8.0.4",
        "docx": "^9.15.0",
        "jotai": "^2.12.1",
        "katex": "^0.19.1",
        "lexical": "^0.53.0",
        "p-queue": "^9.0.1",
        "pako": "^1.0.11",
        "prop-types": "^15.8.1",
        "prosemirror-model": "^1.25.12",
        "prosemirror-state": "^1.4.4",
        "prosemirror-tables": "^1.8.5",
        "prosemirror-transform": "^1.12.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-markdown": "^10.1.0",
        "rehype-katex": "^7.0.1",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "remark-parse": "^11.0.0",
        "remark-stringify": "^11.0.0",
        "unified": "^11.0.5",
        "uuid": "^11.0.5",
        "zotero-plugin-toolkit": "^5.2.0"
    },
    "devDependencies": {
        "@babel/core": "^7.26.9",
        "@babel/plugin-transform-runtime": "^7.26.9",
        "@babel/preset-env": "^7.26.9",
        "@babel/preset-react": "^7.26.3",
        "@eslint/js": "^9.19.0",
        "@solana/wallet-standard-features": "^1.5.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/diff": "^7.0.2",
        "@types/lodash": "^4.17.27",
        "@types/node": "^22.13.0",
        "@types/react": "^18.3.20",
        "@types/react-dom": "^18.3.6",
        "babel-loader": "^9.2.1",
        "better-sqlite3": "^12.6.2",
        "concurrently": "^9.1.2",
        "dotenv": "^17.2.3",
        "eslint": "^9.19.0",
        "eslint-scope": "^8.3.0",
        "jsdom": "^27.0.1",
        "commander": "^12.1.0",
        "prettier": "^3.9.10",
        "sharp": "^0.35.5",
        "tsx": "^4.23.15",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^3.2.4",
        "webpack": "^5.112.2",
        "webpack-cli": "^6.0.1",
        "zotero-plugin-scaffold": "^0.9.3",
        "zotero-types": "^4.1.3"
    },
    "prettier": {
        "printWidth": 80,
        "tabWidth": 4,
        "endOfLine": "lf",
        "overrides": [
            {
                "files": [
                    "*.xhtml"
                ],
                "options": {
                    "htmlWhitespaceSensitivity": "css"
                }
            }
        ]
    }
}
