# Dependency install scripts are the usual way a compromised package runs code
# on install, so none run. Packages that need theirs are rebuilt explicitly by
# `npm run rebuild:native` (see CLAUDE.md).
ignore-scripts=true

# Resolve only versions published at least 7 days ago (npm >= 11.10; older npm
# ignores it). Applies when npm resolves versions (install, update), not to
# `npm ci`, which installs the lockfile as is.
min-release-age=7
