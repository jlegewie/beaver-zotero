{
  // Standalone typecheck for the client-agnostic core.
  // These files are compiled WITHOUT the zotero-types ambient globals; the
  // only host globals available are the narrow declarations in globals.d.ts.
  // `types: []` keeps @types packages out of the automatic program, and
  // `verify-program.mjs` is what catches an explicit import reaching into
  // @types, zotero-types, or any package the core does not declare.
  //
  // `skipLibCheck: true` is load-bearing rather than incidental: with no DOM
  // lib and `types: []`, typechecking *inside* a dependency's own .d.ts flags
  // its uses of fetch/BroadcastChannel/setInterval as missing names. Core code
  // is still fully checked against those dependencies' types, and
  // `verify-program.mjs` re-checks the package's own declarations with the flag
  // off so globals.d.ts keeps failing loudly.
  //
  // When core code needs a host global, declare it in globals.d.ts. Do not
  // reach for a `lib` entry that supplies it (DOM, WebWorker, …) or delete the
  // `lib`/`types` lines: each licenses a whole host surface inside the core,
  // which is exactly what globals.d.ts exists to prevent. `verify-program.mjs`
  // rejects all of those.
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": [],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  // The full transitive closure, listed explicitly so the package surface is
  // readable. `verify-program.mjs` keeps this list honest.
  "files": [
    "./src/globals.d.ts",
    "./src/protocol/agentProtocol.ts",
    "./src/protocol/wordProtocol.ts",
    "./src/transport/connectionFailure.ts",
    "./src/extract/document/dom/schema.ts",
    "./src/extract/document/epub/schema.ts",
    "./src/extract/document/shared/contentKinds.ts",
    "./src/extract/document/shared/documentExtractResult.ts",
    "./src/extract/document/snapshot/schema.ts",
    "./src/identity/libraryRef.ts",
    "./src/extract/types.ts",
    "./src/extract/schema.ts",
    "./src/agents/types.ts",
    "./src/agents/messageVisibility.ts",
    "./src/types/actions.ts",
    "./src/types/attachments/apiTypes.ts",
    "./src/types/citations.ts",
    "./src/types/customChatModel.ts",
    "./src/types/librarySuggestions.ts",
    "./src/types/profile.ts",
    "./src/types/zotero.ts",
    "./src/citations/citationGrammar.ts",
    "./src/citations/atoms.ts",
    "./src/citations/externalReferences.ts",

    // Reached through the inline `import('../agents/agentActionTypes')` type
    // references in agentProtocol.ts, and from there the agent-action payload
    // types they describe.
    "./src/agents/agentActionTypes.ts",
    "./src/types/agentActions/base.ts",
    "./src/types/agentActions/items.ts",
    "./src/types/agentActions/editNote.ts",
    "./src/types/agentActions/editNoteBatch.ts",
    "./src/types/agentActions/annotations.ts",
    "./src/types/agentActions/createAnnotations.ts",
    "./src/types/agentActions/editAnnotations.ts",
    "./src/types/externalReferences.ts",

    // The transport layer: the agent connection and the backend clients, plus
