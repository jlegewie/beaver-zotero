{
  // Standalone typecheck for the client-agnostic wire-protocol closure.
  // These files are compiled WITHOUT the zotero-types ambient globals; the
  // only host globals available are the narrow declarations in globals.d.ts.
  // `types: []` keeps @types packages out of the automatic program, and
  // `verify-program.mjs` asserts the program matches the `files` list exactly
  // — that check, not `types: []`, is what catches an explicit import pulling
  // in @types or zotero-types.
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["ES2020"],
    "types": [],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  // The full transitive closure, listed explicitly so the package surface is
  // readable. `verify-program.mjs` keeps this list honest.
  "files": [
    "./globals.d.ts",
    "../../src/services/agentProtocol.ts",
    "../../src/services/connectionFailure.ts",
    "../../src/services/documentExtraction/dom/schema.ts",
    "../../src/services/documentExtraction/epub/schema.ts",
    "../../src/services/documentExtraction/shared/contentKinds.ts",
    "../../src/services/documentExtraction/shared/documentExtractResult.ts",
    "../../src/services/documentExtraction/snapshot/schema.ts",
    "../../src/utils/libraryRef.ts",
    "../../src/beaver-extract/types.ts",
    "../../src/beaver-extract/schema/schema.ts",
    "../../react/agents/types.ts",
    "../../react/types/actions.ts",
    "../../react/types/attachments/apiTypes.ts",
    "../../react/types/citations.ts",
    "../../react/types/customChatModel.ts",
    "../../react/types/librarySuggestions.ts",
    "../../react/types/profile.ts",
    "../../react/types/zotero.ts",
    "../../react/utils/citationGrammar.ts",

    // Reached through the inline `import('../../react/agents/agentActionTypes')`
    // type references in agentProtocol.ts, and from there the agent-action
    // payload types they describe.
    "../../react/agents/agentActionTypes.ts",
    "../../react/types/agentActions/base.ts",
    "../../react/types/agentActions/items.ts",
    "../../react/types/agentActions/editNote.ts",
    "../../react/types/agentActions/editNoteBatch.ts",
    "../../react/types/agentActions/annotations.ts",
    "../../react/types/agentActions/createAnnotations.ts",
    "../../react/types/externalReferences.ts"
  ]
}
